# 会记 Minutes 平台环境变量模板
# 复制到仓库根目录并改名为 .env 后使用：cp infra/.env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=minutes
POSTGRES_PASSWORD=minutes
POSTGRES_DB=minutes
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://minutes:minutes@postgres:5432/minutes

# ---------- Redis ----------
REDIS_PORT=6379
# 配置后任务进 Redis 队列，由 compose 的 worker 服务消费；留空则流水线退回进程内
REDIS_URL=redis://redis:6379/0

# ---------- MinIO / 对象存储 ----------
MINIO_ROOT_USER=minutes
MINIO_ROOT_PASSWORD=minutes-minio-secret
S3_ENDPOINT=http://minio:9000
S3_BUCKET=minutes
S3_ACCESS_KEY=minutes
S3_SECRET_KEY=minutes-minio-secret
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- API ----------
API_PORT=8000
# 必填：至少 24 位随机密钥，生成方式：openssl rand -hex 32
# 未设置或使用示例值时 api 会拒绝启动（有意为之）
MINUTES_JWT_SECRET=
MINUTES_ACCESS_TTL=3600
MINUTES_REFRESH_TTL=2592000
# /dev/reset 默认关闭；本地演示或跑 E2E 时临时置 1
MINUTES_ENABLE_RESET=0
# 仅本地单测/无密钥演示时使用；生产禁止开启
MINUTES_ALLOW_INSECURE_JWT=0
MINUTES_LOG_FORMAT=json
MINUTES_LOG_LEVEL=INFO
MINUTES_PIPELINE_SCALE=1
# Worker 单任务最大尝试次数，超过后写入死信 minutes:jobs:dead
MINUTES_JOB_MAX_ATTEMPTS=3

# ---------- 语音识别 ----------
# local（默认，免费离线 faster-whisper）/ aliyun（云端）/ mock（演示模板）
ASR_PROVIDER=local
# 模型优先使用 apps/api/models 内置权重（免安装包/Docker 完整构建会内置）；
# 若源码包不含模型权重，镜像构建阶段会自动从 HuggingFace 下载（见 Dockerfile 的 HF_ENDPOINT）
# 运行时也可填 tiny/base/small/medium 走 HuggingFace 自动下载
LOCAL_ASR_MODEL=/models/faster-whisper-small
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_COMPUTE_TYPE=int8
# 识别提示词（可选，会议热词）；留空时中文默认「以下是普通话的句子。」
LOCAL_ASR_PROMPT=
# 国内下载模型建议走镜像，海外可留空
HF_ENDPOINT=https://hf-mirror.com

# 阿里云备选（ASR_PROVIDER=aliyun 时使用）
# 控制台 → 智能语音交互 → 全部项目 → 项目 Appkey
ALIYUN_NLS_APP_KEY=
# 二选一：控制台临时 Token（有有效期）或 RAM AccessKey（自动换取并缓存 Token）
ALIYUN_NLS_TOKEN=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_REGION=cn-shanghai
# 8000（电话录音）/ 16000（普通会议录音）
ALIYUN_NLS_SAMPLE_RATE=16000

# ---------- 云端 LLM 摘要 ----------
# 配了 LLM_API_KEY 即启用真实 AI 摘要（OpenAI 兼容接口，默认阿里通义 qwen-plus）
# 留空则摘要走内置演示模板；Key 仅在后端使用，不会下发浏览器
# 阿里云百炼控制台申请：https://bailian.console.aliyun.com/ → API-KEY 管理
LLM_PROVIDER=auto
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT=90

# ---------- Web ----------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MOCKING=off
