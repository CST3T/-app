# 会记 Minutes 平台环境变量模板
# 复制到仓库根目录并改名为 .env 后使用：cp infra/.env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=minutes
POSTGRES_PASSWORD=minutes
POSTGRES_DB=minutes
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://minutes:minutes@postgres:5432/minutes

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- MinIO / 对象存储 ----------
MINIO_ROOT_USER=minutes
MINIO_ROOT_PASSWORD=minutes-minio-secret
S3_ENDPOINT=http://minio:9000
S3_BUCKET=minutes
S3_ACCESS_KEY=minutes
S3_SECRET_KEY=minutes-minio-secret
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- API ----------
API_PORT=8000
# 必填：至少 24 位随机密钥，生成方式：openssl rand -hex 32
# 未设置或使用示例值时 api 会拒绝启动（有意为之）
MINUTES_JWT_SECRET=
MINUTES_ACCESS_TTL=3600
MINUTES_REFRESH_TTL=2592000
# /dev/reset 默认关闭；本地演示或跑 E2E 时临时置 1
MINUTES_ENABLE_RESET=0
# 仅本地单测/无密钥演示时使用；生产禁止开启
MINUTES_ALLOW_INSECURE_JWT=0
MINUTES_LOG_FORMAT=json
MINUTES_LOG_LEVEL=INFO
MINUTES_PIPELINE_SCALE=1

# ---------- Web ----------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MOCKING=off
